APP_NAME="Honey Shop"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=honey_shop
DB_USERNAME=honey_shop

POSTGRES_DB=honey_shop
POSTGRES_USER=honey_shop
POSTGRES_PASSWORD=replace-with-a-unique-local-password
POSTGRES_PORT=5433

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
